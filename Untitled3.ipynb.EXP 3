        "# ============================================================\n",
        "# Run this in Google Colab as a single cell.\n",
        "# It will auto-install paho-mqtt if missing, then loop forever\n",
        "# printing/plotting. Use the Colab \"Stop\" button or\n",
        "# Runtime > Interrupt to stop it.\n",
        "# ============================================================\n",
        "\n",
        "import subprocess\n",
        "import sys\n",
        "\n",
        "try:\n",
        "    import paho.mqtt.client as mqtt\n",
        "except ModuleNotFoundError:\n",
        "    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"paho-mqtt\"], check=True)\n",
        "    import paho.mqtt.client as mqtt\n",
        "\n",
        "import json\n",
        "import random\n",
        "import threading\n",
        "import time\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from IPython.display import clear_output\n",
        "\n",
        "# ---------------- MQTT Configuration ----------------\n",
        "BROKER = \"broker.hivemq.com\"\n",
        "PORT = 1883\n",
        "TOPIC = \"IoT_AI_LAB/AirQualityAnalytics\"\n",
        "\n",
        "# ---------------- Data Storage ----------------\n",
        "pm25_data = []\n",
        "co2_data = []\n",
        "timestamps = []\n",
        "\n",
        "# ---------------- Publisher ----------------\n",
        "# Use CallbackAPIVersion for compatibility with newer paho-mqtt versions on Colab\n",
        "try:\n",
        "    publisher = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1)\n",
        "except AttributeError:\n",
        "    publisher = mqtt.Client()\n",
        "\n",
        "def start_publisher():\n",
        "    publisher.connect(BROKER, PORT)\n",
        "\n",
        "    while True:\n",
        "        pm25 = round(random.uniform(10, 180), 2)      # PM2.5 in micrograms/m3\n",
        "        co2 = round(random.uniform(350, 1200), 2)     # CO2 in ppm\n",
        "\n",
        "        payload = {\n",
        "            \"pm25\": pm25,\n",
        "            \"co2\": co2\n",
        "        }\n",
        "\n",
        "        publisher.publish(TOPIC, json.dumps(payload))\n",
        "        time.sleep(1)\n",
        "\n",
        "# ---------------- Subscriber ----------------\n",
        "try:\n",
        "    subscriber = mqtt.Client(mqtt.CallbackAPIVersion.VERSION1)\n",
        "except AttributeError:\n",
        "    subscriber = mqtt.Client()\n",
        "\n",
        "def on_connect(client, userdata, flags, rc):\n",
        "    client.subscribe(TOPIC)\n",
        "\n",
        "def on_message(client, userdata, msg):\n",
        "\n",
        "    data = json.loads(msg.payload.decode())\n",
        "\n",
        "    pm25 = data[\"pm25\"]\n",
        "    co2 = data[\"co2\"]\n",
        "\n",
        "    pm25_data.append(pm25)\n",
        "    co2_data.append(co2)\n",
        "    timestamps.append(len(timestamps))\n",
        "\n",
        "subscriber.on_connect = on_connect\n",
        "subscriber.on_message = on_message\n",
        "\n",
        "subscriber.connect(BROKER, PORT)\n",
        "\n",
        "# ---------------- Threads ----------------\n",
        "threading.Thread(target=start_publisher, daemon=True).start()\n",
        "threading.Thread(target=subscriber.loop_forever, daemon=True).start()\n",
        "\n",
        "# ---------------- Real-Time Analytics ----------------\n",
        "while True:\n",
        "\n",
        "    if len(pm25_data) > 5:\n",
        "\n",
        "        clear_output(wait=True)\n",
        "\n",
        "        df = pd.DataFrame({\n",
        "            \"Time\": timestamps,\n",
        "            \"PM2_5\": pm25_data,\n",
        "            \"CO2\": co2_data\n",
        "        })\n",
        "\n",
        "        avg_pm25 = df[\"PM2_5\"].mean()\n",
        "        avg_co2 = df[\"CO2\"].mean()\n",
        "\n",
        "        df[\"Status\"] = df[\"PM2_5\"].apply(\n",
        "            lambda x: \"Anomaly\" if x > 150 or x < 12 else \"Normal\"\n",
        "        )\n",
        "\n",
        "        print(\"=\" * 60)\n",
        "        print(\"REAL-TIME STREAM ANALYTICS USING MQTT - AIR QUALITY\")\n",
        "        print(\"=\" * 60)\n",
        "        print(df.tail(10))\n",
        "\n",
        "        print(\"\\nAverage PM2.5       :\", round(avg_pm25, 2))\n",
        "        print(\"Average CO2         :\", round(avg_co2, 2))\n",
        "        print(\"Maximum PM2.5       :\", df[\"PM2_5\"].max())\n",
        "        print(\"Minimum PM2.5       :\", df[\"PM2_5\"].min())\n",
        "        print(\"Total Messages      :\", len(df))\n",
        "        print(\"Anomalies Detected  :\", (df[\"Status\"] == \"Anomaly\").sum())\n",
        "\n",
        "        plt.figure(figsize=(12, 5))\n",
        "\n",
        "        plt.plot(df[\"Time\"], df[\"PM2_5\"], marker='o', label=\"PM2.5 (µg/m³)\")\n",
        "        plt.plot(df[\"Time\"], df[\"CO2\"], marker='s', label=\"CO2 (ppm)\")\n",
        "\n",
        "        anomaly = df[df[\"Status\"] == \"Anomaly\"]\n",
        "\n",
        "        plt.scatter(anomaly[\"Time\"],\n",
        "                    anomaly[\"PM2_5\"],\n",
        "                    color=\"red\",\n",
        "                    s=120,\n",
        "                    label=\"Anomaly\")\n",
        "\n",
        "        plt.title(\"Real-Time Stream Analytics - Air Quality\")\n",
        "        plt.xlabel(\"Time\")\n",
        "        plt.ylabel(\"Sensor Values\")\n",
        "        plt.grid(True)\n",
        "        plt.legend()\n",
        "\n",
        "        plt.show()\n",
        "\n",
        "    time.sleep(2)"
      ]
    }
  ]
